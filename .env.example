# Copy this file to .env and fill in values as needed.

# Override the MLflow tracking database path (default: ./mlflow.db)
# MLFLOW_TRACKING_URI=sqlite:////absolute/path/to/mlflow.db

# Override the MLflow experiment name (default: login-form-detection)
# MLFLOW_EXPERIMENT_NAME=login-form-detection

# Set to 1 to suppress MLflow agent hints in logs
# MLFLOW_DISABLE_AGENT_HINT=1
